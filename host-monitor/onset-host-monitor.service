[Unit]
Description=Onset PVE host, VM and Docker monitor
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/onset-host-monitor
ExecStart=/usr/bin/python3 /opt/onset-host-monitor/host_monitor.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
